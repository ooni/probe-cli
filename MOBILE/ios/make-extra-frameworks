#!/bin/bash
set -euxo pipefail

TOPDIR=$(dirname $(dirname $(dirname $(realpath $0))))
WORK=$(mktemp -d)

# make_xcframework constructs a library-based .xcframework.
#
# We package the static libraries as plain libraries rather than as frameworks.
#
# This function does not bother itself with installing headers because we have
# already used the relevant headers when invoking `gomobile bind`.
#
# Arguments:
#
# - $1 is the name of the library to package.
function make_xcframework() {
	local name=$1
	shift

	# Start afresh.
	rm -rf MOBILE/ios/${name}.xcframework

	# Create iphoneos/arm64 library.
	mkdir -p $WORK/iphoneos
	xcrun lipo $TOPDIR/internal/libtor/iphoneos/arm64/lib/${name}.a -create \
		-output $WORK/iphoneos/${name}.a

	# Create iphonesimulator/{amd,arm}64 library.
	mkdir -p $WORK/iphonesimulator
	xcrun lipo $TOPDIR/internal/libtor/iphonesimulator/amd64/lib/${name}.a \
		$TOPDIR/internal/libtor/iphonesimulator/arm64/lib/${name}.a \
		-create -output $WORK/iphonesimulator/${name}.a

	# Create a .xcframework.
	xcodebuild -create-xcframework -library $WORK/iphoneos/${name}.a \
		-library $WORK/iphonesimulator/${name}.a -output MOBILE/ios/${name}.xcframework
}

make_xcframework libz
make_xcframework libcrypto
make_xcframework libssl
make_xcframework libevent
make_xcframework libtor
