{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleConfig",
  "description": "Config contains the experiment's configuration.",
  "type": "object",
  "x-ooni": {
    "goType": "Config"
  },
  "properties": {
    "domain": {
      "type": "string",
