{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCPPingConfig",
  "description": "Config contains the experiment configuration.",
  "type": "object",
  "x-ooni": {
    "goType": "Config"
  },
  "properties": {
    "delay": {
      "type": "integer",
      "description": "number of milliseconds to wait before sending each ping",
      "x-ooni": { "name": "Delay", "omitempty": true }
    },
    "repetitions": {
      "type": "integer",
      "description": "number of times to repeat the measurement",
      "x-ooni": { "name": "Repetitions", "omitempty": true }
    }
  }
}
