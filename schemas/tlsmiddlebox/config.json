{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "generated by `go run ./internal/cmd/configkit`; DO NOT EDIT.",
  "experiment_name": "tlsmiddlebox",
  "title": "tlsmiddlebox experiment config",
  "version": "3.32.0-alpha",
  "experiment_version": "0.1.6",
  "type": "object",
  "properties": {
    "resolver_url": {
      "type": "string",
      "description": "URL for DoH resolver"
    },
    "sni_control": {
      "type": "string",
      "description": "control SNI value for testhelper"
    },
    "delay": {
      "type": "integer",
      "description": "delay between consecutive iterations"
    },
    "maximum_ttl": {
      "type": "integer",
      "description": "maximum TTL value to iterate upto"
    },
    "test_helper": {
      "type": "string",
      "description": "testhelper URL to use for tracing"
    },
    "client_id": {
      "type": "integer",
      "description": "ClientHello fingerprint to use"
    },
    "privacy_mode": {
      "type": "string",
      "description": "privacy mode to use for traceroutes"
    }
  }
}
